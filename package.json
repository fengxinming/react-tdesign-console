    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.2.1",
    "less": "^4.9.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "stylus": "^0.64.0",
