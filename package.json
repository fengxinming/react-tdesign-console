    "i18next": "^26.4.0",
    "nprogress": "^0.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.12",
    "react-router": "^8",
    "react-transition-group": "^4.4.5",
    "screenfull": "^6.0.2",
    "tdesign-icons-react": "0.6.12",
    "tdesign-react": "1.18.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
