html, body
  width 100%
  height 100%
  margin 0
  padding 0
  font-size 12px

// TDesign 把亮/暗两套色盘挂在 html 上（--td-* 等），body 在变量作用域内。
// 页面底色直接用 TDesign 的背景变量，明暗切换（html[theme-mode='dark']）时自动跟随。
// / TDesign mounts both light/dark palettes on html (--td-*), so body is in scope.
html, body
  min-height 100%
  color var(--td-text-color-primary)
  background-color var(--td-bg-color-page)

.chart-wrapper
  .g2-tooltip
    background linear-gradient(
      304.17deg,
      rgb(253 254 255 / 60%) -6.04%,
      rgb(244 247 252 / 60%) 85.2%
    ) !important
    border-radius 6px
    backdrop-filter blur(10px)
    padding 8px !important
    width 180px !important
    opacity 1 !important

[theme-mode='dark']
  .chart-wrapper
    .g2-tooltip
      background linear-gradient(
        304.17deg,
        rgba(90, 92, 95, 0.6) -6.04%,
        rgba(87, 87, 87, 0.6) 85.2%
      ) !important
      backdrop-filter blur(10px)
      border-radius 6px
      box-shadow none !important

.t-card
  h1, h2, h3, h4, h5, h6
    margin-top 0
    margin-bottom 16px

/* nprogress 导航进度条：官方默认蓝 #29d 改为项目主题色。
#nprogress 挂在 body 下，commons/html.ts 的 setThemeColor 把主色同步到
html 上的 --td-brand-color，这里直接读取即可。 */
#nprogress
  .bar
    background var(--td-brand-color)

  .peg
    box-shadow 0 0 10px var(--td-brand-color), 0 0 5px var(--td-brand-color)
