$nav-size-height = 60px

.layout
  width 100%
  height 100%

  &-navbar
    position fixed
    width 100%
    min-width 0
    top 0
    left 0
    height $nav-size-height
    z-index 100

  &-content
    background-color var(--td-bg-color-page)
    padding-top $nav-size-height
    min-height calc(100vh - $nav-size-height)
    transition padding-left 0.2s
    box-sizing border-box
    overflow-x hidden

    &.no-header
      padding-top 0
      min-height 100vh

    &-wrapper
      padding 16px 20px 0
      min-height calc(100vh - $nav-size-height)
      box-sizing border-box
