.layout-sider
  position fixed
  height 100%
  top 0
  left 0
  z-index 99
  box-sizing border-box
  // padding-top 60px
  background-color var(--td-bg-color-container)

  &.no-header
    padding-top 0
    min-height 100vh

  ::-webkit-scrollbar
    width 12px
    height 4px

  ::-webkit-scrollbar-thumb
    border 4px solid transparent
    background-clip padding-box
    border-radius 7px
    background-color var(--td-text-color-placeholder)

  ::-webkit-scrollbar-thumb:hover
    background-color var(--td-text-color-secondary)

  &::after
    content ''
    display block
    position absolute
    top 0
    right -1px
    width 1px
    height 100%
    background-color var(--td-component-stroke)

  > :global(.t-menu)
    height 100%

  .collapse-btn
    position absolute
    top 50%
    right -16px
    transform translateY(-50%)
    width 16px
    height 64px
    background-color var(--td-component-stroke)
    color var(--td-text-color-primary)
    clip-path polygon(0 0, 100% 22%, 100% 78%, 0 100%)
    cursor pointer
    display flex
    justify-content center
    align-items center
    z-index 2

    &::before
      content ''
      position absolute
      top 1px
      right 1px
      bottom 1px
      left 0
      background-color var(--td-bg-color-container)
      clip-path polygon(0 0, 100% 22%, 100% 78%, 0 100%)
      z-index 0

    :global(.t-icon)
      position relative
      z-index 1

    &:hover
      background-color var(--td-brand-color)

      &::before
        background-color var(--td-brand-color-light)

.menu-wrapper
  overflow-y auto
  overflow-x hidden
  height 100%
  box-sizing border-box

  :global(.t-menu)
    width 100% !important
    min-width 0
    height 100%

  // TDesign 子菜单标题项
  :global(.t-submenu > .t-menu__item)
    font-weight 500
