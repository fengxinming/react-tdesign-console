.workplace
  display flex
  width 100%

.left
  flex 1
  min-width 0
  margin-right 16px

.right
  flex 0 0 280px
  min-width 0

@media (max-width 1200px)
  .workplace
    flex-direction column

  .left
    flex none
    width 100%
    margin-right 0
    margin-bottom 16px

  .right
    flex none
    width 100%

@media (max-width 767px)
  .split-col
    margin-bottom 16px

@media (max-width 600px)
  .table-col-secondary
    display none

  .popular-table
    :global(col:nth-child(3)),
    :global(col:nth-child(4))
      display none

    :global(.t-pagination__select)
      display none

.caret-green
  color var(--td-success-color)

.caret-red
  color var(--td-error-color)

// Overview 统计项
.stat
  &-item
    display flex
    align-items center
    padding-left 20px
    color var(--td-text-color-primary)

    @media (max-width 600px)
      padding-left 12px

  &-icon
    display flex
    align-items center
    justify-content center
    width 54px
    height 54px
    background-color var(--td-bg-color-secondarycontainer)
    border-radius 50%
    margin-right 12px

    @media (max-width 600px)
      width 44px
      height 44px
      margin-right 8px

    :global
      .t-icon
        font-size 27px

  &-col
    &:not(:last-child)
      border-right 1px solid var(--td-component-stroke)

    @media (max-width 900px)
      width 50% !important

    @media (max-width 600px)
      width 100% !important

      &:not(:last-child)
        border-right none

  &-title
    font-size 12px
    color var(--td-text-color-primary)

  &-count
    font-size 22px
    font-weight 600
    color var(--td-text-color-primary)

  &-unit
    font-size 12px
    font-weight 400
    color var(--td-text-color-secondary)
    margin-left 8px

.chart
  &-header
    display flex
    justify-content space-between
    margin-bottom 16px

  &-sub-title
    font-size 12px
    font-weight 400
    margin-left 4px
    color var(--td-text-color-placeholder)

// Overview
.growth-icon
  font-size 18px
  color var(--td-success-color)

// Shortcuts
.shortcut
  &-list
    display grid
    grid-template-columns 33.33% 33.33% 33.33%

  &-item
    display flex
    flex-direction column
    align-items center
    justify-content center
    padding 12px
    box-sizing border-box
    cursor pointer

    ^[1]:hover ^[0]-icon
      background-color var(--td-brand-color-light)

      svg
        color var(--td-brand-color)

    ^[1]:hover ^[0]-title
      color var(--td-brand-color)

  &-icon
    display flex
    justify-content center
    align-items center
    width 32px
    height 32px
    border-radius 6px
    background-color var(--td-bg-color-secondarycontainer)
    margin-bottom 4px

    svg
      font-size 18px

  &-title
    font-size 12px
    line-height 20px
    color var(--td-text-color-primary)

.recent
  font-weight 500
  font-size 16px
  line-height 24px
  color var(--td-text-color-primary)
  margin-bottom 16px

// Carousel
.carousel
  width 100%
  height 160px

  &-img
    width 100%
    transform translateY(-30px)

// Announcement
.announcement
  &-item
    display flex
    align-items center
    width 100%
    height 24px
    margin-bottom 4px

  &-text
    flex 1
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    margin-left 4px
    color var(--td-text-color-secondary)
    text-decoration none
    font-size 13px
    cursor pointer

// Docs
.docs
  display grid
  grid-template-columns 50% 50%

.doc-link
  color var(--td-text-color-secondary)
  padding 4px
  box-sizing border-box
  margin-bottom 12px

  &:hover
    color var(--td-brand-color)
