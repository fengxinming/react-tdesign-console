.wrapper
  padding 24px 16px
  background-color var(--td-bg-color-page)
  box-sizing border-box
  min-height calc(100vh - 168px)

.result
  margin 60px 0 24px

@media (min-width: 900px)
  .wrapper
    padding 24px 150px

  .result
    margin 150px 0 36px

.steps-wrapper
  width 100%
  min-width fit-content
  padding 20px
  background-color var(--td-bg-color-secondarycontainer)
  box-sizing border-box
  margin-bottom 150px
