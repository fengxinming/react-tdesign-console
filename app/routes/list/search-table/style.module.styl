.search-form-wrapper
  display flex
  border-bottom 1px solid var(--td-component-stroke)
  margin-bottom 20px

  .right-button
    display flex
    flex-direction column
    justify-content space-between
    padding-left 20px
    margin-bottom 20px
    border-left 1px solid var(--td-component-stroke)
    box-sizing border-box

.search-form
  padding-right 20px

  // TDesign Form labelAlign="left" 对应 .t-form__label--left
  // / TDesign Form labelAlign="left" maps to .t-form__label--left
  :global(.t-form__label--left)
    white-space nowrap

.content-type
  display flex

  > svg
    margin-right 8px
    margin-top 4px

@media (max-width: 767px)
  .search-form-wrapper
    flex-direction column

    .right-button
      flex-direction row
      gap 12px
      padding-left 0
      border-left 0
      margin-top 8px