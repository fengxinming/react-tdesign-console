.container
  :global
    // 旧的 list-content / card-meta-title 规则在本页没有对应节点
    // （本页未使用 List / Card.Meta），已删除
    // / The old list-content and card-meta-title rules had no matching nodes here
    // (this page uses neither List nor Card.Meta), so they were removed

    // 分组标题由 TDesign Typography.Title level="h5" 渲染，对应 h5.t-typography
    // / group headings come from TDesign Typography.Title level="h5" → h5.t-typography
    h5.t-typography
      font-size 14px
      margin-top 16px
      margin-bottom 12px

.card-block
  margin-bottom 16px

  // TDesign Card 头部 = .t-card__header（卡片标题容器，默认内边距）
  // / TDesign card head = .t-card__header (title container, default padding)
  :global(.t-card__header)
    height auto
    padding 16px
    padding-bottom 0

  &:hover
    box-shadow 4px 4px 10px rgba(0, 0, 0, 10%)

    .title
      .more
        opacity 1

  .title
    display flex
    line-height 24px
    align-items center
    font-size 14px
    font-weight 500

    .icon
      height 24px
      width 24px
      // 圆形图标底色跟随主题主色，文字用「实底上的文本」token
      // / icon badge follows the theme primary; text uses the on-solid text token
      color var(--td-font-white-1)
      background var(--td-brand-color)
      text-align center
      line-height 24px
      border-radius 50%
      margin-right 8px

    .more
      color var(--td-text-color-disabled)
      font-size 16px
      position absolute
      right 16px
      cursor pointer
      opacity 0

  .title-more
    .more
      opacity 1

  // TDesign Descriptions 单元格：标签 .t-descriptions__label，内容是 td
  // / TDesign Descriptions cells: label .t-descriptions__label, value is td
  .time, .content > :global(.t-typography), :global(.t-descriptions__label), :global(.t-descriptions__body td)
    font-size 12px
    font-weight 400
    color var(--td-text-color-placeholder)
    padding 0
    line-height 20px

  :global(.t-descriptions__body td:not(.t-descriptions__label))
    color var(--td-text-color-secondary)
    padding-left 6px

  .content
    height 48px

  &-skeleton
    // TDesign Skeleton 的占位行 = .t-skeleton__row
    // / TDesign Skeleton placeholder rows = .t-skeleton__row
    :global(.t-skeleton__row:not(:last-child))
      height 14px
      margin-bottom 8px

.add-card
  text-align center
  cursor pointer

  .description
    margin-top 16px
    color var(--td-text-color-placeholder)
    font-weight 400

  // TDesign Card 卡体 / TDesign card body
  :global(.t-card__body)
    padding-top 52px
    padding-bottom 64px