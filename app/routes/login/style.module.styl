.container
  display flex
  height 100vh
  // 右侧表单区底色：TDesign 的容器级底色 token --td-bg-color-container（浅色 #FFFFFF / 深色自动推导）；
  // 显式声明，避免依赖 html/body（不在变量作用域内，取不到值）
  // / right-hand form panel background: TDesign's container-level token --td-bg-color-container
  background-color var(--td-bg-color-container)

  .banner
    width 550px
    background linear-gradient(163.85deg, #1d2129 0%, #00308f 100%)
    // 窄视口下允许 banner 收缩、内容裁切，避免右侧表单被挤出视口（对齐参考站行为）
    // / allow banner to shrink on narrow viewports so the form is never pushed off-screen
    overflow hidden

  .content
    flex 1
    position relative
    padding-bottom 40px

  .footer
    width 100%
    position absolute
    bottom 0
    right 0

.logo
  position fixed
  top 24px
  left 22px
  display inline-flex
  align-items center
  z-index 1

  &-text
    margin-left 4px
    margin-right 4px
    font-size 20px
    // logo 固定在深色 banner 上，用 TDesign 的「实色/深色背景上的文字」token
    // / the logo sits on the dark banner; TDesign's token for text on a solid/dark background
    color var(--td-text-color-anti)

.banner
  display flex
  justify-content center
  align-items center

  &-inner
    height 100%
    flex 1

.content
  display flex
  justify-content center
  align-items center

.carousel
  height 100%

  &-item
    display flex
    flex-direction column
    justify-content center
    align-items center
    // TDesign Carousel（内部基于 slick）fade 模式下 slide 为 absolute 定位，height:100% 参照链断裂
    // 导致内容贴顶；用 100vh 显式撑满（banner 即 100vh），恢复垂直居中对齐参考站
    // / fade-mode slides are absolutely positioned so height:100% collapses;
    // explicit 100vh restores vertical centering to match the reference site
    height 100vh

  &-title
    padding 0 16px
    text-align center
    font-weight 500
    font-size 20px
    line-height 28px
    // 位于深色 banner 上，用 TDesign 的 --td-font-white-1 / text on the dark banner
    color var(--td-text-color-anti)

  &-sub-title
    padding 0 16px
    text-align center
    margin-top 8px
    font-size 14px
    line-height 22px
    // 位于深色 banner 上；同 token 降不透明度表达次级文字
    // / on the dark banner; same token with reduced opacity for secondary emphasis
    color var(--td-text-color-anti)
    opacity 0.65

  &-image
    margin-top 30px
    width min(320px, 80%)

.login-form
  &-wrapper
    width 320px
    max-width calc(100% - 32px)

  &-title
    font-size 24px
    font-weight 500
    color var(--td-text-color-primary)
    line-height 32px

  &-sub-title
    font-size 16px
    line-height 24px
    color var(--td-text-color-secondary)

  &-register-btn
    color var(--td-text-color-secondary) !important
