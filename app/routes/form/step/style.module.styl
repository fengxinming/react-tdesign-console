.container
  // TDesign Card 卡体 / TDesign card body
  :global(.t-card__body)
    > h5
      margin 0

    padding 20px

.wrapper
  width 100%
  max-width 624px
  margin 0 auto
  padding 56px 16px 70px
  box-sizing border-box

  // 窄屏下步骤条横向滚动，避免撑宽整张卡片
  :global(.t-steps)
    overflow-x auto

.form
  width 100%
  box-sizing border-box
  margin-top 76px

.form-extra
  width 100%
  max-width 895px
  box-sizing border-box
  margin 54px auto
  background-color var(--td-bg-color-secondarycontainer)
  padding 20px
  margin-bottom 120px

@media (min-width: 768px)
  .form
    padding-right 76px
